+    if active >= workspace_settings().max_active_jobs:
+        raise WorkspaceError(429, "research_job_budget_exceeded")
+    row.status, row.failure_reason = "queued", None
+    row.lease_id = row.lease_device_id = row.lease_until = None
+    db.flush()
+    return row
