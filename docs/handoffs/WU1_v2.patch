diff --git a/backend/tests/test_workspace_contract.py b/backend/tests/test_workspace_contract.py
--- a/backend/tests/test_workspace_contract.py
+++ b/backend/tests/test_workspace_contract.py
@@ -1,3 +1,20 @@
+def test_detail_availability_contract_is_exposed_by_detail_api(bootstrapped):
+    from fastapi.testclient import TestClient
+    from app.main import app
+
+    with TestClient(app) as client:
+        response = client.get('/api/workspace/instruments/510300.SH')
+
+    assert response.status_code == 200
+    payload = response.json()
+    assert payload['availability_contract_version'] == 'detail-availability-v1'
+    assert set(payload['availability']) >= {'instrument', 'price', 'history', 'price_basis', 'indicators', 'volume', 'forecasts', 'decision', 'support_resistance'}
+    assert payload['actionable'] is False
+
+def test_detail_availability_does_not_promote_feature_shortage_to_volume(bootstrapped):
+    from fastapi.testclient import TestClient
+    from app.main import app
+    with TestClient(app) as client:
+        payload = client.get('/api/workspace/instruments/510300.SH').json()
+    assert payload['availability']['volume']['reason_code'] != 'feature_shortage'
+    assert payload['actionable'] is False
