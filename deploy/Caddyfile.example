# Replace the domain and email, then install this file as /etc/caddy/Caddyfile.
# The application uses the server-local account password configuration. Keep
# AUTH_COOKIE_SECURE=true behind this HTTPS reverse proxy.
{
  email admin@example.com
}

fund.example.com {
  encode zstd gzip
  # OCR_MAX_IMAGE_BYTES defaults to 10 MiB; 12 MB leaves multipart overhead.
  request_body {
    max_size 12MB
  }
  reverse_proxy 127.0.0.1:8080 {
    # Do not forward a client-provided X-Forwarded-For chain. Uvicorn proxy
    # headers are disabled in Compose, so this is defence in depth.
    header_up -X-Forwarded-For
    header_up X-Forwarded-For {remote_host}
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Frame-Options "SAMEORIGIN"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "same-origin"
    -Server
  }
  log {
    output file /var/log/caddy/fund-decision-access.log
    format json
  }
}
