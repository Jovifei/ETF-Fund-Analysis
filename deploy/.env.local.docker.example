# Local Docker validation template.
# Copy to repo root as .env before `docker compose up`:
#   cp deploy/.env.local.docker.example .env
# Then replace secrets and add TUSHARE_TOKEN when ready for real data.

APP_PORT=8080
POSTGRES_DB=fund_decision
POSTGRES_USER=fundapp
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DB_PASSWORD

APP_NAME=中国ETF_LOF私有决策看板
APP_VERSION=0.7.0
APP_ENV=production
TZ=Asia/Shanghai
AUTH_ENABLED=true
PRIVATE_ACCESS_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
AUTO_CREATE_SCHEMA=false
SQL_ECHO=false
LOG_LEVEL=INFO

CORS_ORIGINS=
TRUSTED_PROXY_HEADERS=true

# Use composite when TUSHARE_TOKEN is set; mock is for structure-only smoke tests.
MARKET_PROVIDER=composite
ALLOW_MOCK_FALLBACK=false
TUSHARE_TOKEN=
TUSHARE_REALTIME_CANDIDATES=rt_etf_k,realtime_quote,rt_k
AKSHARE_TIMEOUT_SECONDS=25

NEWS_RSS_URLS=
NEWS_REFRESH_MINUTES=30
LUNCH_NEWS_REFRESH_MINUTES=10
QUOTE_REFRESH_MINUTES=3
SIGNAL_REFRESH_MINUTES=15
MARKET_CONTEXT_REFRESH_MINUTES=15
SCHEDULER_TICK_SECONDS=30
# Keep scheduler off until provider qualification passes.
SCHEDULER_ENABLED=false
BACKUP_RETENTION_DAYS=30

ANALYSIS_ENABLED=false
ANALYSIS_PRIMARY_PROVIDER=codex_openai_responses
ANALYSIS_PRIMARY_MODEL=
ANALYSIS_PRIMARY_MODE=responses
OPENAI_API_KEY=
ANALYSIS_CODEX_BASE_URL=https://api.openai.com/v1
ANALYSIS_CODEX_ENABLED=false

# Disable OCR for first Docker smoke test; enable local_paddle only after model qualification.
OCR_MODE=disabled
OCR_CLOUD_REVIEW_ENABLED=false
OCR_TRANSIENT_TTL_MINUTES=15
OCR_MAX_IMAGE_BYTES=10485760
OCR_MAX_WIDTH=12000
OCR_MAX_HEIGHT=12000
OCR_MAX_PIXELS=40000000
OCR_TIMEOUT_SECONDS=60
OCR_TRANSIENT_ROOT=/var/lib/china-fund-decision/ocr-transient
OCR_LOCAL_MODEL_DIR=/var/lib/china-fund-decision/ocr-model

LLM_ENABLED=false
