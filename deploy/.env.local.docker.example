# Local Docker validation template.
# Copy to repo root as .env before `docker compose up`:
#   cp deploy/.env.local.docker.example .env
# Then replace secrets and add TUSHARE_TOKEN when ready for real data.

APP_PORT=8080
POSTGRES_DB=fund_decision
POSTGRES_USER=fundapp
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DB_PASSWORD

APP_NAME=中国ETF_LOF私有决策看板
APP_VERSION=0.7.0
# Local Docker serves plain HTTP on 127.0.0.1, so retain development here.
# Production deployment uses deploy/.env.production.example and HTTPS.
APP_ENV=development
TZ=Asia/Shanghai
AUTH_ENABLED=true
# Browser account mode. Generate AUTH_PASSWORD_HASH locally with
# python scripts/generate_password_hash.py; email is only an optional alias.
AUTH_USERNAME=
AUTH_EMAIL=
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_MINUTES=480
# Docker's default http://127.0.0.1 development URL needs false. Production HTTPS must use true.
AUTH_COOKIE_SECURE=false
# Optional legacy machine/API credential for CLI callers, never browser login.
PRIVATE_ACCESS_TOKEN=
AUTO_CREATE_SCHEMA=false
SQL_ECHO=false
LOG_LEVEL=INFO

CORS_ORIGINS=
TRUSTED_PROXY_HEADERS=true

# 行情开关（改这一行即可，然后 docker compose up -d api）：
#   akshare    = 免费：AKShare 调东方财富公开 ETF/LOF 日线与现价，无需 Tushare，前期测试用这个
#   mock       = 本地假数据，只验证页面，永远不可当真实行情
#   tushare    = 只走 Tushare（必须填 TUSHARE_TOKEN，且积分要够）
#   composite  = 有 Token 先 Tushare，失败再 AKShare；已资格的 FTShare 才能作为最后备用
#   public_composite = AKShare 主源；有 Token 时 Tushare 第二候选；已资格的 FTShare 最后备用
MARKET_PROVIDER=akshare
ALLOW_MOCK_FALLBACK=false
# 前期可留空。Tushare 不是月租软件：注册可有免费积分门槛；买积分才加频次/接口。官方价目会变，见 https://tushare.pro/document/1?doc_id=290
TUSHARE_TOKEN=
TUSHARE_REALTIME_CANDIDATES=rt_etf_k,realtime_quote,rt_k
AKSHARE_TIMEOUT_SECONDS=25

# FTShare 只读备用源（默认关闭，必须先运行资格探测并人工确认）
FTSHARE_ENABLED=false
FTSHARE_QUALIFICATION=unverified
FTSHARE_BASE_URL=https://market.ft.tech/gateway
FTSHARE_ALLOW_CUSTOM_BASE_URL=false
FTSHARE_TIMEOUT_SECONDS=20
FTSHARE_MAX_PAGES=10
FTSHARE_MAX_ROWS=10000
FTSHARE_MAX_DATE_SPAN_DAYS=366
FTSHARE_MAX_RESPONSE_BYTES=2000000

NEWS_RSS_URLS=
NEWS_REFRESH_MINUTES=30
LUNCH_NEWS_REFRESH_MINUTES=10
QUOTE_REFRESH_MINUTES=3
SIGNAL_REFRESH_MINUTES=15
MARKET_CONTEXT_REFRESH_MINUTES=15
SCHEDULER_TICK_SECONDS=30
# Keep scheduler off until provider qualification passes.
SCHEDULER_ENABLED=false
BACKUP_RETENTION_DAYS=30

ANALYSIS_ENABLED=false
ANALYSIS_PRIMARY_PROVIDER=codex_openai_responses
ANALYSIS_PRIMARY_MODEL=
ANALYSIS_PRIMARY_MODE=responses
OPENAI_API_KEY=
ANALYSIS_CODEX_BASE_URL=https://api.openai.com/v1
ANALYSIS_CODEX_ENABLED=false

# Disable OCR for first Docker smoke test; enable local_paddle only after model qualification.
OCR_MODE=disabled
OCR_CLOUD_REVIEW_ENABLED=false
OCR_TRANSIENT_TTL_MINUTES=15
OCR_MAX_IMAGE_BYTES=10485760
OCR_MAX_WIDTH=12000
OCR_MAX_HEIGHT=12000
OCR_MAX_PIXELS=40000000
OCR_TIMEOUT_SECONDS=60
OCR_TRANSIENT_ROOT=/var/lib/china-fund-decision/ocr-transient
OCR_LOCAL_MODEL_DIR=/var/lib/china-fund-decision/ocr-model

LLM_ENABLED=false
