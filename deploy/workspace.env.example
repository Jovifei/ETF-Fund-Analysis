# Copy to deploy/workspace.env (ignored by Git); set a private random URL-safe password.
# The stack is loopback-only and uses a separate Compose project and empty DB.
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_URL_SAFE_PASSWORD
WORKSPACE_PORT=8081
APP_ENV=development
AUTH_COOKIE_SECURE=false
MARKET_PROVIDER=public_composite
# Models never run in API/data-worker. These two controls are independent opt-ins.
WORKSPACE_BRIDGE_ENABLED=false
WORKSPACE_DAILY_REVIEW_ENABLED=false
WORKSPACE_DAILY_JOB_BUDGET=5
WORKSPACE_MAX_ACTIVE_JOBS=3
OCR_MODE=disabled
# Public HTTPS deployment: APP_ENV=production and AUTH_COOKIE_SECURE=true.
# Do not place a Codex login file, model API key or device token in this file.
