# Copy OUTSIDE the repository. Never commit the private copy.
# Linux: chmod 600 the private file. Windows: restrict its ACL to your account.
MARKET_PROVIDER=public_composite
TUSHARE_TOKEN=
TUSHARE_TIMEOUT_SECONDS=20
AKSHARE_TIMEOUT_SECONDS=20
NEWS_RSS_URLS=
NEWS_RSS_TIMEOUT_SECONDS=20
MINUTE_BARS_ENABLED=false
FTSHARE_ENABLED=false
FTSHARE_QUALIFICATION=unqualified
WORKSPACE_BRIDGE_ENABLED=false
WORKSPACE_DAILY_REVIEW_ENABLED=false
# Local-only optional registration. Keep disabled unless you deliberately
# bootstrap a private test account; production Compose ignores this runner.
# REGISTRATION_ENABLED=false
# REGISTRATION_INVITE_CODE=

# Optional low-frequency public catalog + industry/concept discovery (no model calls).
WORKSPACE_DISCOVERY_ENABLED=false
