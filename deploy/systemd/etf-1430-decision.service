[Unit]
Description=ETF 14:30 research decision report
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=etfresearch
Group=etfresearch
WorkingDirectory=/opt/china-fund-decision
Environment=ETF_DECISION_PROJECT_DIR=/opt/china-fund-decision
ExecStart=/opt/china-fund-decision/scripts/run_1430_decision.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/china-fund-decision/reports /tmp

[Install]
WantedBy=multi-user.target
