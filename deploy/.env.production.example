# --- Compose / PostgreSQL ---
APP_PORT=8080
POSTGRES_DB=fund_decision
POSTGRES_USER=fundapp
# Use URL-safe characters unless you URL-encode the DATABASE_URL yourself.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DB_PASSWORD

# --- Application ---
APP_NAME=中国ETF_LOF私有决策看板
APP_ENV=production
TZ=Asia/Shanghai
AUTH_ENABLED=true
PRIVATE_ACCESS_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
AUTO_CREATE_SCHEMA=false
SQL_ECHO=false
LOG_LEVEL=INFO

# API is bound to 127.0.0.1 by docker-compose. Keep CORS empty for same-origin use.
CORS_ORIGINS=
TRUSTED_PROXY_HEADERS=true

# --- China market data ---
# Recommended production value: composite (Tushare first, AKShare fallback).
MARKET_PROVIDER=composite
ALLOW_MOCK_FALLBACK=false
TUSHARE_TOKEN=
TUSHARE_REALTIME_CANDIDATES=rt_etf_k,realtime_quote,rt_k
AKSHARE_TIMEOUT_SECONDS=25

# Optional: comma-separated ordinary RSS/Atom URLs or routes from your own RSSHub.
# Do not paste private URLs containing credentials into Git.
NEWS_RSS_URLS=
NEWS_RSS_TIMEOUT_SECONDS=20

# --- Runtime defaults (can also be changed in the web UI) ---
QUOTE_REFRESH_MINUTES=3
SIGNAL_REFRESH_MINUTES=15
NEWS_REFRESH_MINUTES=30
LUNCH_NEWS_REFRESH_MINUTES=10
BACKUP_RETENTION_DAYS=30
SCHEDULER_TICK_SECONDS=30
SCHEDULER_ENABLED=true

# --- OpenAI-compatible news structuring ---
LLM_ENABLED=false
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# chat_completions or responses
LLM_API_MODE=chat_completions
LLM_TIMEOUT_SECONDS=50
LLM_MAX_INPUT_CHARS=12000
