# Copy this file to the server-local /opt/china-fund-decision/.env, replace every
# CHANGE_ME value, then chmod 0600 .env. Never commit or paste the resulting file.

# --- Compose / PostgreSQL ---
APP_PORT=8080
POSTGRES_DB=fund_decision
POSTGRES_USER=fundapp
# Use URL-safe characters unless you URL-encode the DATABASE_URL yourself.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DB_PASSWORD

# --- Application ---
APP_NAME=中国ETF_LOF私有决策看板
APP_VERSION=0.7.0
APP_ENV=production
TZ=Asia/Shanghai
AUTH_ENABLED=true
PRIVATE_ACCESS_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
AUTO_CREATE_SCHEMA=false
SQL_ECHO=false
LOG_LEVEL=INFO

# API is bound to 127.0.0.1 by docker-compose. Keep CORS empty for same-origin use.
CORS_ORIGINS=
TRUSTED_PROXY_HEADERS=true

# --- China market data (Mock is not actionable) ---
# Recommended production value: composite (Tushare first, AKShare fallback).
MARKET_PROVIDER=composite
ALLOW_MOCK_FALLBACK=false
TUSHARE_TOKEN=
TUSHARE_REALTIME_CANDIDATES=rt_etf_k,realtime_quote,rt_k
AKSHARE_TIMEOUT_SECONDS=25

# Optional FTShare read-only fallback. Keep disabled and unqualified until the
# bounded qualification report is reviewed. The application never executes
# the third-party Skill and never accepts a user-supplied URL/tool name.
FTSHARE_ENABLED=false
FTSHARE_QUALIFICATION=unverified
FTSHARE_BASE_URL=https://market.ft.tech/gateway
FTSHARE_ALLOW_CUSTOM_BASE_URL=false
FTSHARE_TIMEOUT_SECONDS=20
FTSHARE_MAX_PAGES=10
FTSHARE_MAX_ROWS=10000
FTSHARE_MAX_DATE_SPAN_DAYS=366
FTSHARE_MAX_RESPONSE_BYTES=2000000

# Optional: comma-separated ordinary RSS/Atom URLs or routes from your own RSSHub.
# Do not paste private URLs containing credentials into Git.
NEWS_RSS_URLS=
NEWS_RSS_TIMEOUT_SECONDS=20

# --- Runtime and scheduler bounds ---
# --- Runtime defaults (can also be changed in the web UI) ---
QUOTE_REFRESH_MINUTES=3
SIGNAL_REFRESH_MINUTES=15
NEWS_REFRESH_MINUTES=30
LUNCH_NEWS_REFRESH_MINUTES=10
MARKET_CONTEXT_REFRESH_MINUTES=15
SCHEDULER_TICK_SECONDS=30
SCHEDULER_ENABLED=true
BACKUP_RETENTION_DAYS=30

# --- One primary analysis provider (off by default; startup fails closed if
# enabled with any required field below left empty) ---
# Codex/OpenAI Responses is the only enabled primary in this release. These are
# exact server-local names: key, model, base URL, and mode.
ANALYSIS_ENABLED=false
ANALYSIS_PRIMARY_PROVIDER=codex_openai_responses
ANALYSIS_PRIMARY_MODEL=
ANALYSIS_PRIMARY_MODE=responses
OPENAI_API_KEY=
ANALYSIS_CODEX_BASE_URL=https://api.openai.com/v1
ANALYSIS_CODEX_ENABLED=false
ANALYSIS_CODEX_TIMEOUT_SECONDS=50
ANALYSIS_PROMPT_VERSION=analysis-v1
ANALYSIS_SCHEMA_VERSION=analysis-v1
ANALYSIS_MAX_INPUT_CHARS=12000

# Registered for an explicit manual switch only; do not enable alongside Codex.
ANALYSIS_ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANALYSIS_ANTHROPIC_BASE_URL=https://api.anthropic.com
ANALYSIS_ANTHROPIC_TIMEOUT_SECONDS=50
ANALYSIS_DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
ANALYSIS_DEEPSEEK_BASE_URL=https://api.deepseek.com
ANALYSIS_DEEPSEEK_TIMEOUT_SECONDS=50

# Legacy LLM_* bridge is retained for compatibility and stays off by default.
LLM_ENABLED=false
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# chat_completions or responses
LLM_API_MODE=chat_completions
LLM_TIMEOUT_SECONDS=50
LLM_MAX_INPUT_CHARS=12000

# --- Portfolio screenshot OCR ---
# Pillow is always available. PaddleOCR/PaddlePaddle and its model are optional,
# local-only, and must be provisioned and qualified separately on Linux.
OCR_MODE=local_paddle
OCR_CLOUD_REVIEW_ENABLED=false
OCR_TRANSIENT_TTL_MINUTES=15
OCR_MAX_IMAGE_BYTES=10485760
OCR_MAX_WIDTH=12000
OCR_MAX_HEIGHT=12000
OCR_MAX_PIXELS=40000000
OCR_TIMEOUT_SECONDS=60
# Transient root must pre-exist as a 0700 private directory; model dir must exist (startup fails closed with a clear message otherwise).
OCR_TRANSIENT_ROOT=/var/lib/china-fund-decision/ocr-transient
OCR_LOCAL_MODEL_DIR=/var/lib/china-fund-decision/ocr-model
