<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ app_name }} · {{ generated_at.strftime('%Y-%m-%d %H:%M') }}</title>
<style>
:root{color-scheme:dark;--bg:#071019;--panel:#101d2b;--line:#294158;--text:#e6edf4;--muted:#adbdca;--quiet:#a1b1bf;--up:#ff766e;--down:#5bd0a5;--warn:#e5b45b;--accent:#54d6d2}
*{box-sizing:border-box}body{margin:0;background-color:var(--bg);background-image:linear-gradient(rgba(84,214,210,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(84,214,210,.035) 1px,transparent 1px);background-size:34px 34px;color:var(--text);font:14px/1.55 "Cascadia Mono","SFMono-Regular",Consolas,"Microsoft YaHei",monospace}.wrap{max-width:1500px;margin:0 auto;padding:26px}.header{display:flex;justify-content:space-between;gap:24px;align-items:flex-end;margin-bottom:20px}.header h1{margin:0;font-family:Georgia,"Times New Roman",serif;font-size:25px;font-weight:500}.meta{color:var(--muted);font-size:11px}.cards{display:grid;grid-template-columns:repeat(5,minmax(150px,1fr));gap:12px;margin-bottom:18px}.card,.section{background:rgba(16,29,43,.95);border:1px solid var(--line);border-radius:3px;box-shadow:0 10px 30px rgba(0,0,0,.16)}.card{padding:15px}.card b{display:block;font-size:26px;margin-top:6px}.section{margin:14px 0;overflow:hidden}.section h2{font-size:17px;font-family:Georgia,"Times New Roman",serif;font-weight:500;margin:0;padding:14px 16px;border-bottom:1px solid var(--line)}table{width:100%;border-collapse:collapse}th,td{padding:11px 10px;border-bottom:1px solid rgba(41,65,88,.7);text-align:left;vertical-align:top;white-space:nowrap}th{font-size:11px;color:var(--muted);background:#0b1723;position:sticky;top:0}.name{font-weight:700}.code,.small{font-size:10px;color:var(--muted)}.tag{display:inline-block;padding:2px 7px;border:1px solid var(--line);border-radius:2px;font-size:10px}.up{color:var(--up)}.down{color:var(--down)}.warn{color:var(--warn)}.reasons{white-space:normal;min-width:270px;max-width:420px}.news{padding:0 16px}.news article{padding:13px 0;border-bottom:1px solid var(--line)}.news h3{font-size:14px;margin:0 0 5px}.disclaimer{padding:14px 16px;color:var(--muted);font-size:12px}.market-context-grid{display:grid;grid-template-columns:repeat(6,1fr)}.context-card{min-height:174px;padding:14px;border-right:1px solid var(--line);}.context-card:last-child{border-right:0}.context-identity{font-family:Georgia,"Times New Roman",serif;font-size:14px}.context-status{color:var(--muted);font-size:10px}.context-change{margin-top:20px;font-size:22px;font-weight:700}.context-level{color:var(--muted);font-size:10px}.observed-surface{background:rgba(16,29,43,.95)}.forecast-surface{padding:8px;border:1px solid rgba(84,214,210,.34);border-radius:3px;background:linear-gradient(135deg,rgba(18,55,64,.7),rgba(18,34,48,.88));color:#d9f4f1;white-space:normal;min-width:180px}.forecast-label{color:var(--accent);font-size:9px;font-weight:700;letter-spacing:.4px}.forecast-value{margin-top:4px;color:#f1dfad;font-size:14px;font-weight:700}.forecast-meta{margin-top:3px;color:#a5bbc2;font-size:9px;line-height:1.35}.provenance{margin-top:7px;color:var(--quiet);font-size:9px;white-space:normal;line-height:1.35}
.table-wrap{max-width:100%;overflow:auto}.observed-surface{min-width:0}@media(max-width:900px){.wrap{padding:14px}.cards{grid-template-columns:repeat(2,minmax(140px,1fr))}.market-context-grid{grid-template-columns:repeat(2,minmax(150px,1fr))}.context-card:nth-child(2n){border-right:0}.context-card:nth-child(n+3){border-top:1px solid var(--line)}.header{display:block}.header .meta{margin-top:6px}.table-wrap{width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}}@media(max-width:560px){.cards,.market-context-grid{grid-template-columns:1fr}.context-card{border-right:0;border-top:1px solid var(--line)}.context-card:first-child{border-top:0}.section h2{font-size:16px}.table-wrap table{min-width:980px}}
</style>
<style>
:root{--muted:#adbdca;--quiet:#a1b1bf}
.code,.small,.tag,.context-status,.context-registry-status,.provenance,.forecast-label,.forecast-meta{font-size:11px}
.quote-state-badge{display:inline-block;margin-top:6px;padding:2px 5px;border:1px solid rgba(173,189,202,.45);color:var(--muted);font-size:11px}.quote-state-badge.is-mock,.quote-state-badge.degraded,.quote-state-badge.stale{border-color:rgba(229,180,91,.58);color:#f1d18e}
.table-wrap{max-width:100%;overflow:auto}.observed-surface{min-width:0}
@media(max-width:900px){.wrap{padding:14px}.cards{grid-template-columns:repeat(2,minmax(140px,1fr))}.market-context-grid{grid-template-columns:repeat(2,minmax(150px,1fr))}.context-card:nth-child(2n){border-right:0}.context-card:nth-child(n+3){border-top:1px solid var(--line)}.header{display:block}.header .meta{margin-top:6px}.table-wrap{width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}}
@media(max-width:560px){.cards,.market-context-grid{grid-template-columns:1fr}.context-card{border-right:0;border-top:1px solid var(--line)}.context-card:first-child{border-top:0}.section h2{font-size:16px}.table-wrap table{min-width:980px}}
</style>
</head>
<body><main class="wrap">{% autoescape true %}
{% macro displayIdentity(code, name) -%}{{ (code or '')|e }}{% if code and name %} · {% endif %}{{ (name or '未知标的')|e }}{%- endmacro %}
<header class="header"><div><h1>{{ app_name }}</h1><div class="meta">不可变研究快照 · {{ generated_at.isoformat() }}</div></div><div class="meta">内容哈希 {{ content_hash }}</div></header>
<div class="cards">
<div class="card"><span class="meta">观察标的</span><b>{{ summary.get('instrument_count','—') }}</b></div>
<div class="card"><span class="meta">实时行情</span><b>{{ summary.get('live_quote_count','—') }}</b></div>
<div class="card"><span class="meta">上涨/下跌</span><b><span class="up">{{ summary.get('market_width',{}).get('up',0) }}</span>/<span class="down">{{ summary.get('market_width',{}).get('down',0) }}</span></b></div>
<div class="card"><span class="meta">可入场/试探</span><b>{{ summary.get('state_counts',{}).get('可入场',0) + summary.get('state_counts',{}).get('可试探',0) }}</b></div>
<div class="card"><span class="meta">减仓/风险观察</span><b>{{ summary.get('state_counts',{}).get('减仓',0) + summary.get('state_counts',{}).get('风险观察',0) }}</b></div>
</div>
<section class="section observed-surface" aria-labelledby="market-context-heading"><h2 id="market-context-heading">市场环境 · 观察值</h2><div class="market-context-grid">
{% set contexts = market_context|default([]) %}{% if not contexts %}{% set contexts = [{'label':'中国行业/板块广度与轮动','enabled':False,'verification_status':'unverified'},{'label':'S&P 500','enabled':False,'verification_status':'unverified'},{'label':'Nasdaq Composite','enabled':False,'verification_status':'unverified'},{'label':'Nasdaq-100','enabled':False,'verification_status':'unverified'},{'label':'中国半导体可交易 ETF 代理','enabled':False,'verification_status':'unverified'},{'label':'韩国半导体可交易 ETF 代理','enabled':False,'verification_status':'unverified'}] %}{% endif %}
{% for item in contexts %}{% set observation=item.observation if item.observation is defined and item.observation else item %}{% set change=observation.get('today_pct_change') %}{% set freshness=observation.get('freshness') or 'unavailable' %}{% set verification=observation.get('verification_status') or 'unverified' %}{% set status='Mock · ' ~ freshness if observation.get('is_mock') else 'unavailable · ' ~ freshness if freshness in ['degraded','unavailable'] else verification %}<article class="context-card"><div class="context-identity">{{ displayIdentity(item.display_code or item.source_symbol, item.label) }}</div><div class="context-status">{{ status if item.get('enabled', False) else 'unavailable · disabled' }}</div><div class="context-registry-status">registry {{ item.get('verification_status') or 'unverified' }}</div><div class="context-change {{ 'up' if change is not none and change >= 0 else 'down' if change is not none else '' }}">{% if change is not none %}{{ '%+.2f'|format(change) }}%{% else %}—{% endif %}</div><div class="context-level">水平 / 价格：{{ observation.get('observed_value') if observation.get('observed_value') is not none else observation.get('price') if observation.get('price') is not none else '—' }}</div><div class="provenance">来源 {{ observation.get('source') or '—' }} · 源时间 {{ observation.get('source_timestamp') or '—' }} · 抓取 {{ observation.get('fetched_at') or '—' }} · 新鲜度 {{ freshness }} · 验证 {{ verification }}{% if observation.get('is_mock') %} · Mock{% endif %}</div></article>{% endfor %}
</div><div class="disclaimer">未验证或禁用代理保持可见；系统不会为其生成代码、价格或变化。</div></section>
<section class="section"><h2>ETF / LOF 信号</h2><div class="table-wrap"><table><thead><tr><th>标的</th><th>行情</th><th>趋势</th><th>MACD</th><th>KDJ / RSI</th><th>1日预测</th><th>5日</th><th>20日</th><th>信号</th><th>仓位</th><th>理由与风险</th></tr></thead><tbody>
{% for row in instruments %}
{% set q=row.get('quote')|default({}, true) %}{% set i=row.get('indicator')|default({}, true) %}{% set s=row.get('signal')|default({}, true) %}{% set forecasts=row.get('forecasts')|default({}, true) %}{% set f1=forecasts.get('1')|default({}, true) %}{% set f5=forecasts.get('5')|default({}, true) %}{% set f20=forecasts.get('20')|default({}, true) %}
<tr><td><div class="name">{{ displayIdentity(row.ts_code, row.name) }}</div><div class="code">{{ row.theme_l1 or '未分类' }}/{{ row.theme_l2 or '-' }}</div></td>
<td class="observed-surface">{% if q %}<div class="{{ 'up' if q.get('pct_change') is not none and q.get('pct_change')>=0 else 'down' if q.get('pct_change') is not none else '' }}">{% if q.get('pct_change') is not none %}{{ '%+.2f'|format(q.get('pct_change')) }}%{% else %}—{% endif %}</div><div class="small">价格 {{ '%.4f'|format(q.get('price')) if q.get('price') is not none else '—' }}</div><div class="quote-state-badge {{ 'is-mock' if q.get('is_mock') else q.get('freshness') or 'unavailable' }}">{{ 'Mock · degraded' if q.get('is_mock') else q.get('freshness') or ('fresh' if q.get('is_realtime') else 'unavailable') }}</div><div class="provenance">来源 {{ q.get('source') or '—' }} · 源时间 {{ q.get('source_timestamp') or q.get('time') or '—' }} · 抓取 {{ q.get('fetched_at') or '—' }} · 新鲜度 {{ q.get('freshness') or ('fresh' if q.get('is_realtime') else 'unavailable') }} · 验证 {{ q.get('verification_status') or 'unverified' }}</div>{% else %}—{% endif %}</td>
<td>{% if i %}<span class="tag">{{ i.trend_label }}</span><div class="small">技术 {{ '%.1f'|format(i.technical_score) }} / 风险 {{ '%.1f'|format(i.risk_score) }}</div>{% else %}—{% endif %}</td>
<td>{% if i %}DIF {{ i.values.macd_dif }}<br><span class="small">DEA {{ i.values.macd_dea }} / 柱 {{ i.values.macd_hist }}</span>{% else %}—{% endif %}</td>
<td>{% if i %}J {{ i.values.kdj_j }} / RSI {{ i.values.rsi14 }}<br><span class="small">量比 {{ i.values.volume_ratio }} · TD {{ i.values.td_buy_setup }}/{{ i.values.td_sell_setup }}</span>{% else %}—{% endif %}</td>
<td><div class="forecast-surface"><div class="forecast-label">FORECAST · 非实际结果</div>{% if f1 %}<div class="forecast-value">{{ '%.1f'|format(f1.p_up*100) if f1.p_up is not none else '—' }}% · E[r] {{ '%+.2f'|format(f1.expected_return*100) if f1.expected_return is not none else '—' }}%</div><div class="forecast-meta">q10/q50/q90 {{ '%+.2f'|format(f1.q10*100) if f1.q10 is not none else '—' }} / {{ '%+.2f'|format(f1.q50*100) if f1.q50 is not none else '—' }} / {{ '%+.2f'|format(f1.q90*100) if f1.q90 is not none else '—' }}%</div><div class="forecast-meta">horizon {{ f1.horizon if f1.horizon is not none else '—' }} · n={{ f1.sample_count if f1.sample_count is not none else '—' }} · {{ f1.calibration_status if f1.calibration_status is not none else 'not_calibrated' }} · {{ f1.model_version if f1.model_version is not none else '—' }}</div><div class="forecast-meta">as_of {{ f1.as_of_date if f1.as_of_date is not none else '—' }} · generated {{ f1.generated_at if f1.generated_at is not none else '—' }} · cutoff {{ f1.data_cutoff if f1.data_cutoff is not none else '—' }}</div>{% else %}<div class="forecast-value">—</div>{% endif %}</div></td>
<td><div class="forecast-surface"><div class="forecast-label">FORECAST · 非实际结果</div>{% if f5 %}<div class="forecast-value">{{ '%.1f'|format(f5.p_up*100) if f5.p_up is not none else '—' }}% · E[r] {{ '%+.2f'|format(f5.expected_return*100) if f5.expected_return is not none else '—' }}%</div><div class="forecast-meta">q10/q50/q90 {{ '%+.2f'|format(f5.q10*100) if f5.q10 is not none else '—' }} / {{ '%+.2f'|format(f5.q50*100) if f5.q50 is not none else '—' }} / {{ '%+.2f'|format(f5.q90*100) if f5.q90 is not none else '—' }}%</div><div class="forecast-meta">horizon {{ f5.horizon if f5.horizon is not none else '—' }} · n={{ f5.sample_count if f5.sample_count is not none else '—' }} · {{ f5.calibration_status if f5.calibration_status is not none else 'not_calibrated' }} · {{ f5.model_version if f5.model_version is not none else '—' }}</div><div class="forecast-meta">as_of {{ f5.as_of_date if f5.as_of_date is not none else '—' }} · generated {{ f5.generated_at if f5.generated_at is not none else '—' }} · cutoff {{ f5.data_cutoff if f5.data_cutoff is not none else '—' }}</div>{% else %}<div class="forecast-value">—</div>{% endif %}</div></td>
<td><div class="forecast-surface"><div class="forecast-label">FORECAST · 非实际结果</div>{% if f20 %}<div class="forecast-value">{{ '%.1f'|format(f20.p_up*100) if f20.p_up is not none else '—' }}% · E[r] {{ '%+.2f'|format(f20.expected_return*100) if f20.expected_return is not none else '—' }}%</div><div class="forecast-meta">q10/q50/q90 {{ '%+.2f'|format(f20.q10*100) if f20.q10 is not none else '—' }} / {{ '%+.2f'|format(f20.q50*100) if f20.q50 is not none else '—' }} / {{ '%+.2f'|format(f20.q90*100) if f20.q90 is not none else '—' }}%</div><div class="forecast-meta">horizon {{ f20.horizon if f20.horizon is not none else '—' }} · n={{ f20.sample_count if f20.sample_count is not none else '—' }} · {{ f20.calibration_status if f20.calibration_status is not none else 'not_calibrated' }} · {{ f20.model_version if f20.model_version is not none else '—' }}</div><div class="forecast-meta">as_of {{ f20.as_of_date if f20.as_of_date is not none else '—' }} · generated {{ f20.generated_at if f20.generated_at is not none else '—' }} · cutoff {{ f20.data_cutoff if f20.data_cutoff is not none else '—' }}</div>{% else %}<div class="forecast-value">—</div>{% endif %}</div></td>
<td>{% if s %}<span class="tag {{ 'warn' if not s.is_actionable else '' }}">{{ s.state }}</span><div class="small">分 {{ '%.1f'|format(s.score) }} · 置信 {{ '%.1f'|format(s.confidence) }}</div>{% else %}—{% endif %}</td>
<td>{% if row.holding %}现有持仓<br><span class="small">目标 {{ '%.1f'|format((s.first_step_target_weight or 0)*100) if s else '-' }}%</span>{% else %}<span class="small">未持有</span>{% endif %}</td>
<td class="reasons">{% if s %}<div>{{ '；'.join(s.reasons[:4]) }}</div>{% if s.risks %}<div class="warn">风险：{{ '；'.join(s.risks[:4]) }}</div>{% endif %}{% else %}—{% endif %}</td></tr>
{% endfor %}
</tbody></table></div><div class="disclaimer">预测为未校准的历史相似样本基线；显示概率、区间和样本支持，不承诺未来收益。Mock 或退化数据不会标记为执行级信号。</div></section>
<section class="section"><h2>当前持仓</h2><div class="table-wrap"><table><thead><tr><th>标的</th><th>份额</th><th>成本</th><th>现价</th><th>市值</th><th>盈亏</th><th>权重</th></tr></thead><tbody>{% for h in holdings %}<tr><td>{{ displayIdentity(h.get('ts_code'), h.get('name')) }}<div class="code">{{ h.get('theme_l1') or '未分类' }}/{{ h.get('theme_l2') or '-' }}</div></td><td>{{ h.get('shares') }}</td><td>{{ h.get('cost_price') }}</td><td>{{ h.get('latest_price') }}</td><td>{{ h.get('market_value') }}</td><td class="{{ 'up' if (h.get('pnl') or 0)>=0 else 'down' }}">{{ h.get('pnl') }} / {{ h.get('pnl_pct') if h.get('pnl_pct') is not none and (h.get('cost_price') or 0)>0 else '—' }}%</td><td>{{ '%.1f'|format((h.get('current_weight') or 0)*100) }}%</td></tr>{% else %}<tr><td colspan="7">尚未录入持仓</td></tr>{% endfor %}</tbody></table></div></section>
<section class="section"><h2>新闻与主题事件</h2><div class="news">{% for item in news %}<article><h3>{{ item.title }}</h3><div class="meta">{{ item.source }} · {{ item.published_at }} · {{ ', '.join(item.affected_themes) }}</div>{% if item.facts %}<div>事实：{{ '；'.join(item.facts) }}</div>{% endif %}{% if item.inferences %}<div class="small">推断：{{ '；'.join(item.inferences) }}</div>{% endif %}</article>{% else %}<article>暂无新闻</article>{% endfor %}</div></section>
<div class="disclaimer">仅供个人研究，不构成投资建议。市场有风险，任何操作均需自行决策并承担结果。</div>
{% endautoescape %}</main></body></html>
