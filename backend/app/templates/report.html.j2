<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ app_name }} · {{ generated_at.strftime('%Y-%m-%d %H:%M') }}</title>
<style>
:root{color-scheme:dark;--bg:#080d15;--panel:#111722;--line:#263143;--text:#e7edf6;--muted:#8492a6;--up:#ff625f;--down:#22c997;--warn:#e9a23b;--accent:#4aa3ff}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.55 system-ui,-apple-system,"Segoe UI","Microsoft YaHei",sans-serif}.wrap{max-width:1500px;margin:0 auto;padding:26px}.header{display:flex;justify-content:space-between;gap:24px;align-items:flex-end;margin-bottom:20px}.header h1{margin:0;font-size:25px}.meta{color:var(--muted);font-size:12px}.cards{display:grid;grid-template-columns:repeat(5,minmax(150px,1fr));gap:12px;margin-bottom:18px}.card,.section{background:linear-gradient(180deg,#131b28,#0f1621);border:1px solid var(--line);border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,.16)}.card{padding:15px}.card b{display:block;font-size:26px;margin-top:6px}.section{margin:14px 0;overflow:hidden}.section h2{font-size:16px;margin:0;padding:14px 16px;border-bottom:1px solid var(--line)}table{width:100%;border-collapse:collapse}th,td{padding:11px 10px;border-bottom:1px solid rgba(38,49,67,.7);text-align:left;vertical-align:top;white-space:nowrap}th{font-size:12px;color:var(--muted);background:#0d131d;position:sticky;top:0}.name{font-weight:700}.code,.small{font-size:11px;color:var(--muted)}.tag{display:inline-block;padding:2px 7px;border:1px solid var(--line);border-radius:999px;font-size:11px}.up{color:var(--up)}.down{color:var(--down)}.warn{color:var(--warn)}.reasons{white-space:normal;min-width:270px;max-width:420px}.news{padding:0 16px}.news article{padding:13px 0;border-bottom:1px solid var(--line)}.news h3{font-size:14px;margin:0 0 5px}.disclaimer{padding:14px 16px;color:var(--muted);font-size:12px}@media(max-width:900px){.wrap{padding:12px}.cards{grid-template-columns:repeat(2,1fr)}.table-wrap{overflow:auto}.header{display:block}}
</style>
</head>
<body><main class="wrap">
<header class="header"><div><h1>{{ app_name }}</h1><div class="meta">不可变研究快照 · {{ generated_at.isoformat() }}</div></div><div class="meta">内容哈希 {{ content_hash }}</div></header>
<div class="cards">
<div class="card"><span class="meta">观察标的</span><b>{{ summary.instrument_count }}</b></div>
<div class="card"><span class="meta">实时行情</span><b>{{ summary.live_quote_count }}</b></div>
<div class="card"><span class="meta">上涨/下跌</span><b><span class="up">{{ summary.market_width.up }}</span>/<span class="down">{{ summary.market_width.down }}</span></b></div>
<div class="card"><span class="meta">可入场/试探</span><b>{{ summary.state_counts.get('可入场',0) + summary.state_counts.get('可试探',0) }}</b></div>
<div class="card"><span class="meta">减仓/风险观察</span><b>{{ summary.state_counts.get('减仓',0) + summary.state_counts.get('风险观察',0) }}</b></div>
</div>
<section class="section"><h2>ETF / LOF 信号</h2><div class="table-wrap"><table><thead><tr><th>标的</th><th>行情</th><th>趋势</th><th>MACD</th><th>KDJ / RSI</th><th>1日预测</th><th>5日</th><th>20日</th><th>信号</th><th>仓位</th><th>理由与风险</th></tr></thead><tbody>
{% for row in instruments %}
{% set q=row.quote %}{% set i=row.indicator %}{% set s=row.signal %}{% set f1=row.forecasts.get('1') %}{% set f5=row.forecasts.get('5') %}{% set f20=row.forecasts.get('20') %}
<tr><td><div class="name">{{ row.name }}</div><div class="code">{{ row.ts_code }} · {{ row.theme_l1 or '未分类' }}/{{ row.theme_l2 or '-' }}</div></td>
<td>{% if q %}<div class="{{ 'up' if (q.pct_change or 0)>=0 else 'down' }}">{{ '%.4f'|format(q.price) }} / {{ '%+.2f'|format(q.pct_change or 0) }}%</div><div class="small">{{ q.source }} · {{ '实时' if q.is_realtime else '退化' }}</div>{% else %}—{% endif %}</td>
<td>{% if i %}<span class="tag">{{ i.trend_label }}</span><div class="small">技术 {{ '%.1f'|format(i.technical_score) }} / 风险 {{ '%.1f'|format(i.risk_score) }}</div>{% else %}—{% endif %}</td>
<td>{% if i %}DIF {{ i.values.macd_dif }}<br><span class="small">DEA {{ i.values.macd_dea }} / 柱 {{ i.values.macd_hist }}</span>{% else %}—{% endif %}</td>
<td>{% if i %}J {{ i.values.kdj_j }} / RSI {{ i.values.rsi14 }}<br><span class="small">量比 {{ i.values.volume_ratio }} · TD {{ i.values.td_buy_setup }}/{{ i.values.td_sell_setup }}</span>{% else %}—{% endif %}</td>
<td>{% if f1 and f1.p_up is not none %}{{ '%.1f'|format(f1.p_up*100) }}%<br><span class="small">中位 {{ '%+.2f'|format((f1.q50 or 0)*100) }}%</span>{% else %}—{% endif %}</td>
<td>{% if f5 and f5.p_up is not none %}{{ '%.1f'|format(f5.p_up*100) }}%<br><span class="small">{{ '%+.2f'|format((f5.q50 or 0)*100) }}%</span>{% else %}—{% endif %}</td>
<td>{% if f20 and f20.p_up is not none %}{{ '%.1f'|format(f20.p_up*100) }}%<br><span class="small">{{ '%+.2f'|format((f20.q50 or 0)*100) }}%</span>{% else %}—{% endif %}</td>
<td>{% if s %}<span class="tag {{ 'warn' if not s.is_actionable else '' }}">{{ s.state }}</span><div class="small">分 {{ '%.1f'|format(s.score) }} · 置信 {{ '%.1f'|format(s.confidence) }}</div>{% else %}—{% endif %}</td>
<td>{% if row.holding %}现有持仓<br><span class="small">目标 {{ '%.1f'|format((s.first_step_target_weight or 0)*100) if s else '-' }}%</span>{% else %}<span class="small">未持有</span>{% endif %}</td>
<td class="reasons">{% if s %}<div>{{ '；'.join(s.reasons[:4]) }}</div>{% if s.risks %}<div class="warn">风险：{{ '；'.join(s.risks[:4]) }}</div>{% endif %}{% else %}—{% endif %}</td></tr>
{% endfor %}
</tbody></table></div><div class="disclaimer">预测为未校准的历史相似样本基线；显示概率、区间和样本支持，不承诺未来收益。Mock 或退化数据不会标记为执行级信号。</div></section>
<section class="section"><h2>当前持仓</h2><div class="table-wrap"><table><thead><tr><th>标的</th><th>份额</th><th>成本</th><th>现价</th><th>市值</th><th>盈亏</th><th>权重</th></tr></thead><tbody>{% for h in holdings %}<tr><td>{{ h.name }}<div class="code">{{ h.ts_code }}</div></td><td>{{ h.shares }}</td><td>{{ h.cost_price }}</td><td>{{ h.latest_price }}</td><td>{{ h.market_value }}</td><td class="{{ 'up' if h.pnl>=0 else 'down' }}">{{ h.pnl }} / {{ h.pnl_pct if h.pnl_pct is not none else '-' }}%</td><td>{{ '%.1f'|format(h.current_weight*100) }}%</td></tr>{% else %}<tr><td colspan="7">尚未录入持仓</td></tr>{% endfor %}</tbody></table></div></section>
<section class="section"><h2>新闻与主题事件</h2><div class="news">{% for item in news %}<article><h3>{{ item.title }}</h3><div class="meta">{{ item.source }} · {{ item.published_at }} · {{ ', '.join(item.affected_themes) }}</div>{% if item.facts %}<div>事实：{{ '；'.join(item.facts) }}</div>{% endif %}{% if item.inferences %}<div class="small">推断：{{ '；'.join(item.inferences) }}</div>{% endif %}</article>{% else %}<article>暂无新闻</article>{% endfor %}</div></section>
<div class="disclaimer">仅供个人研究，不构成投资建议。市场有风险，任何操作均需自行决策并承担结果。</div>
</main></body></html>
