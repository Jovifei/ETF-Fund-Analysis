    "国防军工": "军工装备",
    "军工": "军工装备",
    "医疗": "医疗器械",
    "医药": "医疗器械",
    "半导体": "半导体",
    "原油": "油气开采及服务",
    "新能源车": "电池",
    "黄金": "贵金属"
  },
  "concept_alias": {
    "_comment": "主题标签 → 概念板块名 的显式映射表（与 sector_alias 平行）。生产环境应使用 AKShare stock_board_concept_name_em 返回的概念板块名；此处示例值对应 mock 与东财常见命名。未登记的主题不显示概念板块（前端 —）。",
    "半导体": "芯片",
    "人工智能": "人工智能",
    "新能源车": "新能源汽车",
    "机器人": "机器人",
    "国防军工": "军工",
    "军工": "军工",
    "医药": "医药",
    "医疗": "医药",
    "创新药": "医药",
    "黄金": "黄金概念"
  },
  "broad_market_themes": ["宽基", "创业板", "科创50"],
  "weights": {
    "trend": 0.22,
    "momentum": 0.20,
    "volume_flow": 0.14,
    "structure": 0.18,
    "forecast": 0.21,
    "news": 0.05
  },
  "thresholds": {
    "buy_candidate": 70,
    "probe": 60,
    "hold": 45,
    "reduce": 35,
    "minimum_risk_reward": 1.25,
    "maximum_quote_age_minutes": 8
  },
  "support_resistance": {
    "pivot_window": 2,
    "pivot_lookback": 120,
    "cluster_tolerance_pct": 0.006,
    "volume_profile_window": 120,
    "volume_profile_bins": 32,
    "chan_segments": 3,
    "chan_segment_bars": 18
  },
  "point_in_time": {
    "accepted_intervals_minutes": [5, 15],
    "feature_cutoff": "14:30",
    "execution_rule": "first_tradable_bar_after_14_30",
    "required_for_historical_1430_claim": true
  },
  "governance": {
    "research_only": true,
    "automatic_orders": false,
    "manual_model_promotion_only": true,
    "default_calibration_status": "not_calibrated",
    "future_candles_are_scenarios": true,
    "chan_is_approximation": true
  }
